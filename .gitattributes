# Shell scripts run on Linux pods: always LF, whatever the checkout platform.
*.sh text eol=lf

# Run receipts are committed byte for byte, so their recorded sha256s hold in every checkout.
docs/runs/receipts/** -text
docs/runs/stage1-eval/** -text
docs/runs/stage1-train/** -text
packages/aspire-si-gates/** -text
docs/runs/stage1-stuck-rule.json -text
docs/runs/stage1-machine-line.json -text
docs/runs/stage1-taskset/** -text

# The frozen set and the pinned NO-ROLE file are read by sha256; keep them byte for byte.
docs/runs/stage1-training-data/FROZEN.md -text
docs/runs/stage1-no-role/** -text
